---
import '../styles/draw.css';
import { KINDS, VIEWBOX, type DrawingKind } from '../lib/drawings';

/**
 * Инженерный чертёж вместо фотографии.
 *
 * Почему так: стоковых снимков стройки в единой гамме взять негде — сеть
 * окружения закрыта, а разнородный по свету сток хуже, чем его отсутствие
 * (раздел 5.6 ТЗ). Инженерная аудитория читает чертёж как «свой».
 *
 * Геометрия считается в src/lib/drawings.ts, начертание — в styles/draw.css.
 * Контуры прочерчиваются линиями при появлении в поле зрения.
 */
export interface Props {
  kind: DrawingKind;
  class?: string;
  /** Подпись под чертежом. */
  caption?: string;
  /** Описание для читающих с экрана. Пустая строка — чертёж декоративный. */
  label: string;
}

const { kind, class: cls = '', caption, label } = Astro.props;
const svg = KINDS[kind]();
const decorative = label === '';
---

<figure class={`dw ${cls}`}>
  <svg
    class="dw-svg"
    viewBox={VIEWBOX}
    data-draw
    preserveAspectRatio="xMidYMid meet"
    role={decorative ? 'presentation' : 'img'}
    aria-label={decorative ? undefined : label}
    aria-hidden={decorative ? 'true' : undefined}
    focusable="false"
    set:html={svg}
  />
  {caption && <figcaption class="dw-cap">{caption}</figcaption>}
</figure>

<style>
  .dw {
    position: relative;
    margin: 0;
  }

  .dw-svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 720 / 620;
    /* Подложка нарочно выходит за viewBox — обрезаем по рамке элемента,
       иначе она расширяет документ и на узких экранах появляется скролл. */
    overflow: hidden;
  }

  .dw-cap {
    margin-top: var(--s4);
    font-size: var(--fs-xs);
    color: var(--tx-dim);
    letter-spacing: 0.02em;
  }
</style>
