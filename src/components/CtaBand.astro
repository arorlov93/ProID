---
import LeadForm from './LeadForm.astro';
import Drawing from './Drawing.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  points?: string[];
  kind?: 'zayavka' | 'checklist' | 'call';
  id?: string;
  service?: string;
  theme?: 'dark' | 'light';
  drawing?: boolean;
}

const {
  eyebrow = 'Дальше',
  title,
  text,
  points = [],
  kind = 'zayavka',
  id,
  service,
  theme = 'dark',
  drawing = false,
} = Astro.props;
---

<section class="sec" data-theme={theme} id={id}>
  <div class="wrap">
    <div class="cta" data-reveal>
      <div class="cta-l">
        <p class="eyebrow eyebrow--accent">{eyebrow}</p>
        <h2>{title}</h2>
        <p class="lead">{text}</p>
        {
          points.length > 0 && (
            <ul class="ul ul--check cta-pts">
              {points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          )
        }
        {drawing && <Drawing kind="title" class="cta-dw" label="Титульный лист тома исполнительной документации со штампом приёмки" />}
      </div>

      <div class="cta-r block">
        <LeadForm kind={kind} id={id ? `${id}-form` : undefined} service={service} compact />
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 480px);
    gap: var(--s10);
    align-items: start;
  }

  .cta-l h2 {
    margin-bottom: var(--s5);
  }

  .cta-pts {
    margin-top: var(--s6);
  }

  .cta-dw {
    margin-top: var(--s8);
    max-width: 420px;
    opacity: 0.75;
  }

  @media (max-width: 980px) {
    .cta {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s8);
    }

    .cta-dw {
      display: none;
    }
  }
</style>
