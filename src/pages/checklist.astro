---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import Drawing from '../components/Drawing.astro';
import Faq from '../components/Faq.astro';
import { breadcrumbs, faqSchema } from '../lib/schema';

const crumbs = [{ href: '/checklist', t: 'Чек-лист состава ИД' }];

/** Разделы чек-листа. Показываем структуру и часть позиций: это и есть материал
 *  под кластер В семантики, а полный файл с нормативными ссылками уходит письмом. */
const sections = [
  {
    t: 'Общая часть тома',
    n: 9,
    items: [
      'Титульный лист с наименованием объекта по разрешению на строительство',
      'Опись документов тома со сквозной нумерацией',
      'Реестр исполнительной документации по разделам',
      'Копии приказов о назначении ответственных за производство работ',
      'Выписки из реестра СРО подрядчика и субподрядчиков',
    ],
  },
  {
    t: 'Журналы',
    n: 11,
    items: [
      'Общий журнал работ: разделы 1–6, заполненные и заверенные',
      'Журнал входного контроля материалов, изделий и конструкций',
      'Журнал бетонных работ с данными о классе, партии и уходе',
      'Журнал сварочных работ с реестром сварных соединений',
      'Журнал антикоррозийной защиты и защиты закладных деталей',
    ],
  },
  {
    t: 'Акты освидетельствования',
    n: 18,
    items: [
      'Акты освидетельствования скрытых работ по приложению 3 РД-11-02-2006',
      'Акты освидетельствования ответственных конструкций по приложению 4',
      'Акты освидетельствования участков сетей инженерно-технического обеспечения',
      'Акты промежуточной приёмки ответственных конструкций',
      'Акты передачи геодезической разбивочной основы',
    ],
  },
  {
    t: 'Исполнительные схемы и геодезия',
    n: 12,
    items: [
      'Исполнительные схемы с фактическими отметками и отклонениями',
      'Ведомость отклонений с сопоставлением с допусками по проекту и СП',
      'Исполнительная съёмка инженерных сетей с привязкой к осям',
      'Схемы расположения закладных деталей и отверстий',
    ],
  },
  {
    t: 'Материалы и качество',
    n: 16,
    items: [
      'Паспорта и сертификаты соответствия с привязкой к акту и партии',
      'Декларации о соответствии на материалы, подлежащие декларированию',
      'Протоколы лабораторных испытаний бетона по срокам твердения',
      'Протоколы контроля сварных соединений неразрушающими методами',
      'Санитарно-эпидемиологические заключения там, где они требуются',
    ],
  },
  {
    t: 'Испытания и пусконаладка',
    n: 10,
    items: [
      'Акты индивидуальных испытаний оборудования',
      'Акты гидравлических и пневматических испытаний трубопроводов',
      'Акты промывки и дезинфекции систем водоснабжения',
      'Протоколы электроизмерений и испытаний электроустановок',
    ],
  },
  {
    t: 'Изменения и отступления',
    n: 8,
    items: [
      'Журнал авторского надзора с отработанными замечаниями',
      'Согласованные изменения проектных решений с отметкой проектировщика',
      'Акты на отступления от проекта с обоснованием и согласованием',
    ],
  },
];

const total = sections.reduce((s, x) => s + x.n, 0);

const faq = [
  { q: 'Чем этот чек-лист отличается от перечня в СП', a: 'Свод правил задаёт рамку, но не отвечает на вопрос «что именно вернёт заказчик». В чек-листе к каждой позиции добавлена пометка о том, как часто на ней спотыкаются и что проверяющий смотрит в первую очередь. Это опыт приёмки, а не пересказ норматива.' },
  { q: 'Под какие объекты он подходит', a: 'Под общестроительные работы и инженерные сети — это база, общая для большинства объектов капитального строительства. Специфика по видам работ, наследию и режимным объектам добавляется сверху и в чек-лист не входит.' },
  { q: 'Позиции обязательны все', a: 'Нет. Состав зависит от видов работ на объекте и от регламента технического заказчика. Чек-лист — это максимальный перечень, из которого вычёркивается неприменимое. Вычёркивать надёжнее, чем вспоминать.' },
  { q: 'На какие нормативы опирается', a: 'СП 68.13330.2017, РД-11-02-2006 и приложения к нему, РД-11-05-2007, ГОСТ Р 21.101-2020 в части оформления. В полной версии у каждой позиции проставлен пункт.' },
  { q: 'Будете звонить после скачивания', a: 'Нет. Письмо с файлом приходит автоматически, рассылки нет. Если захотите обсудить свой комплект — напишете сами.' },
  { q: 'Что делать, если по чек-листу многого не хватает', a: 'Пришлите то, что есть, на бесплатную экспресс-проверку. За один рабочий день скажем, дособирается это оформлением или нужно <a href="/vosstanovlenie-id">восстановление</a>.' },
];
---

<Base
  title="Чек-лист состава исполнительной документации"
  description="Состав исполнительной документации: чек-лист на 84 позиции по СП 68.13330 и РД-11-02-2006. Разложен по разделам, с пометками о частых возвратах. Бесплатно."
  path="/checklist"
  popup={false}
  schema={[breadcrumbs(crumbs), faqSchema(faq)]}
>
  <section class="sec sec--tight" data-theme="dark">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="ch">
        <div>
          <p class="eyebrow eyebrow--accent">Бесплатно</p>
          <h1>Состав исполнительной документации: чек-лист</h1>
          <p class="lead ch-lead">
            Перечень на {total} позиций, по которому технический заказчик проверяет комплект. Разложен по
            семи разделам, с ссылками на пункты СП 68.13330 и РД-11-02-2006 и пометками о том, на чём
            спотыкаются чаще всего. Ниже — структура и часть позиций; полный файл приходит письмом.
          </p>
          <ul class="ul ul--check ch-pts">
            <li>Что входит в том по каждому виду работ</li>
            <li>Какие приложения требуют вместе с актом</li>
            <li>12 позиций, из-за которых комплект возвращают чаще всего</li>
          </ul>
        </div>
        <div class="block ch-form">
          <LeadForm kind="checklist" id="ch-form" compact title="Куда прислать файл" />
        </div>
      </div>
    </div>
  </section>

  <section class="sec" data-theme="light">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div>
          <p class="eyebrow">Структура</p>
          <h2>Семь разделов, {total} позиций</h2>
        </div>
        <p class="mut">
          Состав зависит от видов работ и от регламента заказчика. Это максимальный перечень, из которого
          вычёркивается неприменимое — вычёркивать надёжнее, чем вспоминать.
        </p>
      </div>

      <div class="chs">
        {
          sections.map((s, i) => (
            <section class="card chs-i" data-reveal>
              <header class="chs-h">
                <span class="chs-n num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.t}</h3>
                <span class="chs-c num">{s.n} позиций</span>
              </header>
              <ul class="ul chs-l">
                {s.items.map((it) => <li>{it}</li>)}
                <li class="chs-more">…и ещё {s.n - s.items.length} в полной версии</li>
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec" data-theme="dark">
    <div class="wrap">
      <div class="chc">
        <div>
          <p class="eyebrow eyebrow--accent">Как пользоваться</p>
          <h2>Не список для галочки, а рабочий инструмент</h2>
          <div class="prose chc-tx">
            <p>
              Разложите чек-лист по видам работ на своём объекте и вычеркните неприменимое. Оставшееся —
              это ваш согласуемый состав комплекта. Отправьте его техническому заказчику <b>до начала
              работ</b> и попросите подтвердить письменно.
            </p>
            <p>
              Полчаса на этот разговор в начале стройки экономят недели переделок в конце. Самая дорогая
              категория возвратов — не ошибки в оформлении, а позиции, о существовании которых стороны
              узнают за неделю до сдачи.
            </p>
            <p>
              Дальше держите перечень как живой документ: отмечайте закрытое, отслеживайте то, что
              упирается в исходные данные. К моменту приёмки у вас будет не надежда, а картина.
            </p>
          </div>
        </div>
        <Drawing kind="title" class="chc-dw" label="Титульный лист тома со штампом приёмки и описью состава" />
      </div>
    </div>
  </section>

  <section class="sec" data-theme="light">
    <div class="wrap"><Faq items={faq} title="Вопросы по чек-листу" /></div>
  </section>
</Base>

<style>
  .ch {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--s10);
    align-items: start;
    padding-block: var(--s6) var(--s8);
  }

  .ch-lead { margin-top: var(--s6); }
  .ch-pts { margin-top: var(--s7); }

  @media (max-width: 980px) {
    .ch { grid-template-columns: minmax(0, 1fr); gap: var(--s8); }
  }

  .chs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-card);
  }

  .chs-h {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s4);
    padding-bottom: var(--s5);
    margin-bottom: var(--s5);
    border-bottom: 1px solid var(--bd-soft);
  }

  .chs-n {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--accent-tx);
    letter-spacing: var(--ls-eyebrow);
  }

  .chs-h h3 { flex: 1 1 60%; font-size: var(--fs-h4); margin: 0; }
  .chs-c { font-size: var(--fs-xs); color: var(--tx-dim); white-space: nowrap; }
  .chs-l li { font-size: var(--fs-sm); }
  .chs-more { color: var(--accent-tx) !important; font-style: italic; }
  .chs-more::before { display: none; }

  @media (max-width: 760px) {
    .chs { grid-template-columns: minmax(0, 1fr); }
  }

  .chc {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--s10);
    align-items: center;
  }

  .chc h2 { margin-block: var(--s3) var(--s6); }
  .chc-tx { max-width: var(--measure); }
  .chc-dw { opacity: 0.85; }

  @media (max-width: 900px) {
    .chc { grid-template-columns: minmax(0, 1fr); gap: var(--s7); }
    .chc-dw { display: none; }
  }
</style>
