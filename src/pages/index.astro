---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Calculator from '../components/Calculator.astro';
import PriceTable from '../components/PriceTable.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, stats } from '../data/site';
import { servicesNav } from '../data/nav';
import type { PhotoId } from '../data/photos';
import { byId, fmt, priceLabel } from '../data/prices';
import { faqSchema, itemListSchema } from '../lib/schema';
import { getCollection } from 'astro:content';

const objects = (await getCollection('objects')).sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const tasks = [
  { ic: 'warn', t: 'Заказчик вернул комплект', d: 'Замечания на пять листов, сроки горят, а править некому. Разбираем список, закрываем позиции, выходим на приёмку вместе с вами.' },
  { ic: 'restore', t: 'ИД не велась с начала работ', d: 'Полгода стройки без единого акта. Восстанавливаем комплект по журналам, чатам, накладным и фотофиксации.' },
  { ic: 'team', t: 'Инженер ПТО уволился', d: 'Ушёл вместе с паролями и логикой комплекта. Подхватываем за неделю, дальше ведём сами.' },
  { ic: 'ruble', t: 'Не подписывают КС-2', d: 'Объёмы не бьются с актами, а без подписи нет оплаты. Сводим документы так, чтобы возразить было нечем.' },
  { ic: 'clock', t: 'До сдачи две недели', d: 'Комплекта нет, а комиссия назначена. Собираем в темпе, работаем в две смены, отдаём по разделам.' },
  { ic: 'plan', t: 'Технадзор бракует схемы', d: 'Оформление не по РД-11-02-2006, отметки не сходятся. Переделываем и защищаем в переписке.' },
  { ic: 'crane', t: 'Нужен ППР, разрабатывать некому', d: 'Без проекта производства работ не пускают на площадку. Делаем ППР, ППРк и технологические карты.' },
  { ic: 'audit', t: 'Смету завернули на проверке', d: 'Расценки не те, объёмы задвоены. Проверяем, пересобираем, пишем заключение по расхождениям.' },
] as const;

const process = [
  { n: '01', t: 'Смотрим, что есть', d: 'Присылаете проект, переписку с технадзором и то, что уже собрано. Инженер разбирает материал и называет вилку цены. Обычно в тот же день.' },
  { n: '02', t: 'Считаем и фиксируем', d: 'Договор, объём, сроки по разделам. Понедельная разбивка — вы видите, что будет готово к каждой пятнице.' },
  { n: '03', t: 'Ведём и показываем', d: 'Документы уходят вам по мере готовности, а не одним томом в конце. Расхождения с проектом видны сразу.' },
  { n: '04', t: 'Защищаем на приёмке', d: 'Отрабатываем замечания технадзора и заказчика до подписи. Замечания после сдачи закрываем без доплаты.' },
] as const;

/* Три опорные цены первого экрана — из прайса, а не набранные руками. */
const heroPrices = [byId.aosr, byId.komplekt, byId['abon-s']];

const scenes = [
  {
    ph: 'razbor',
    t: 'Разбор проекта',
    d: 'Начинаем не с бланков, а с проекта. Ищем, где рабочая документация разошлась со стройкой: перенесённые оси, изменённые узлы, снятые с производства материалы. Это те места, откуда потом приходят возвраты.',
  },
  {
    ph: 'vedenie',
    t: 'Ведение по ходу работ',
    d: 'Акт закрывается, пока работа видна, а не через полгода по памяти прораба. Отметки берём из исполнительной геодезии, ссылки на нормативы подставляем сразу, а не при сдаче.',
  },
  {
    ph: 'komplekt',
    t: 'Приёмка комплекта',
    d: 'Том уходит с описью, реестром и титулом, прошитый и пронумерованный. Если у комиссии возникают вопросы, на них отвечает инженер, который этот комплект вёл, а не менеджер.',
  },
] as const;

const faq = [
  {
    q: 'Сколько стоит исполнительная документация и от чего зависит цена',
    a: 'Считаем по объёму, а не по площади объекта. Акт освидетельствования — от 750 ₽, исполнительная схема — от 1 500 ₽, ведение журналов — от 3 500 ₽ в месяц. Комплект под ключ по объекту — от 45 000 ₽. Вилку по вашим вводным даёт <a href="#kalkulyator">калькулятор</a>, полный <a href="/ceny">прайс открыт</a>.',
  },
  {
    q: 'Работаете дистанционно или нужен выезд на объект',
    a: 'Основная работа дистанционная: проект, журналы, переписка и оформление не требуют присутствия. По Москве и области выезжаем на замеры, фотофиксацию и приёмку. В других регионах выезд обсуждаем отдельно — чаще хватает материалов от прораба.',
  },
  {
    q: 'Что делать, если документация вообще не велась',
    a: 'Восстанавливаем задним числом. Собираем исходные данные из общего журнала, накладных, актов на материалы, переписки и фотоотчётов, дальше строим комплект в правильной хронологии. Подробно — на странице <a href="/vosstanovlenie-id">восстановления ИД</a>.',
  },
  {
    q: 'Кто отвечает, если заказчик вернёт комплект',
    a: 'Мы. Замечания по нашим документам отрабатываем без доплаты и без ограничения по количеству кругов, пока комплект не примут. Это записано в договоре, а не обещано на словах.',
  },
  {
    q: 'Чем внешний отдел ПТО выгоднее штатного инженера',
    a: 'Штатный инженер ПТО в Москве обходится примерно в 180 000 ₽ в месяц со всеми взносами, отпуском и простоями. Абонентское обслуживание на один объект — от 60 000 ₽. Считать выгодно до тех пор, пока объектов один-два. Расчёт — <a href="#sravnenie">в таблице ниже</a>.',
  },
  {
    q: 'С какими нормативами работаете',
    a: 'СП 68.13330.2017, РД-11-02-2006 и РД-11-05-2007, ГОСТ Р 21.101-2020 в части оформления, отраслевые своды правил по видам работ. Если у заказчика свой регламент оформления — работаем по нему.',
  },
  {
    q: 'Как быстро начнёте',
    a: 'После согласования объёма — в тот же день. Первая консультация по вашему комплекту бесплатна: смотрим, что есть, и говорим, что с этим делать, даже если работать вместе не начнём.',
  },
];

const schema = [
  faqSchema(faq),
  itemListSchema('Услуги ПрофИД', servicesNav.map((s) => ({ href: s.href, t: s.t }))),
];
---

<Base
  title="Исполнительная документация: заказать в Москве — ПрофИД"
  description="Внешний отдел ПТО: оформление, ведение и восстановление исполнительной документации, ППР и сметы. Москва и область, дистанционно по России. Прайс открыт."
  path="/"
  schema={schema}
>
  <!-- ═══ 1. Первый экран ═══════════════════════════════════════════════ -->
  <section class="sec hero" data-theme="dark">
    <div class="wrap hero-in">
      <div class="hero-l">
        <p class="eyebrow eyebrow--accent">Внешний отдел ПТО · Москва и область</p>
        <h1>Исполнительная документация, которую принимают <i>с первого раза</i></h1>
        <p class="lead hero-lead">
          Оформляем, ведём и восстанавливаем ИД, разрабатываем ППР, считаем и проверяем сметы. Заказать
          можно и отдельный акт, и весь комплект по объекту — работаем как отдел ПТО на вашей стороне и
          не закрываем задачу, пока документы не примут.
        </p>

        <div class="btn-row hero-btns">
          <a class="btn btn--lg" href="#kalkulyator">Рассчитать стоимость</a>
          <a class="btn btn--2 btn--lg" href="/audit-komplekta">Проверить комплект</a>
        </div>

        {/* Цена в первом экране. Раздел с услугой, на котором не написано,
            сколько это стоит, отправляет человека обратно в поиск: считать
            он всё равно будет, но уже на чужом сайте. Числа берутся из
            прайса, поэтому разойтись с таблицей не могут. */}
        <p class="hero-price">
          {
            heroPrices.map((p, i) => (
              <>
                {i > 0 && <span class="hero-price-sep" aria-hidden="true">·</span>}
                <span class="hero-price-i">
                  <b class="num acc">от {fmt(p.from)} ₽</b>
                  <span class="xs dim">за {p.unit}</span>
                </span>
              </>
            ))
          }
          <a class="tlink hero-price-l" href="/ceny">Весь прайс</a>
        </p>

        <p class="hero-badge">
          <span class="pulse" aria-hidden="true"></span>
          {site.responsePromise}
        </p>

        <dl class="hero-stats">
          {
            stats.map((s) => (
              <div class="hero-stat" data-reveal>
                <dt class="hero-num num">
                  <span data-count={s.value}>{s.value}</span>{s.suffix}
                </dt>
                <dd>
                  <b>{s.label}</b>
                  <span class="xs dim">{s.note}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="hero-r">
        <Photo id="hero" eager />
      </div>
    </div>
  </section>

  <!-- ═══ 2. Задачи ════════════════════════════════════════════════════ -->
  <section class="sec" data-theme="light" id="zadachi">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div>
          <p class="eyebrow">Задачи</p>
          <h2>С чем к нам приходят</h2>
        </div>
        <p class="mut">
          Восемь ситуаций, которые повторяются из объекта в объект. Если узнали свою — дальше уже был
          кто-то с такой же, и она решаема.
        </p>
      </div>

      <div class="grid grid--4">
        {
          tasks.map((t) => (
            <article class="card card--hover task" data-reveal>
              <span class="task-ic" aria-hidden="true">
                <Icon name={t.ic} size={22} />
              </span>
              <h3>{t.t}</h3>
              <p>{t.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ 3. Объекты ═══════════════════════════════════════════════════ -->
  <section class="sec" data-theme="dark" id="obekty">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div>
          <p class="eyebrow">Объекты</p>
          <h2>Где мы вели документацию</h2>
        </div>
        <p class="mut">
          Общественные здания, промышленность, инженерная инфраструктура, гидротехника. Разные заказчики
          и разные регламенты приёмки — от этого зависит, как собирается комплект.
        </p>
      </div>

      <div class="obj-grid">
        {
          objects.map((o) => (
            <a class="card card--link obj" href={`/obekty/${o.id}`} data-reveal>
              <div class="obj-media">
                <Photo id={`obekt-${o.id}` as PhotoId} caption="" />
              </div>
              <div class="obj-tx">
                <p class="eyebrow">
                  {o.data.city}
                  {!o.data.year.startsWith('TODO') && <> · {o.data.year}</>}
                </p>
                <h3>{o.data.h1}</h3>
                <p>{o.data.kind}</p>
                <span class="tlink">Что делали</span>
              </div>
            </a>
          ))
        }
      </div>

      <p class="sec-more">
        <a class="tlink" href="/obekty">Все объекты и состав работ</a>
      </p>
    </div>
  </section>

  <!-- ═══ 4. УТП и сравнение с конкурентами ════════════════════════════ -->
  <section class="sec" data-theme="light" id="pochemu">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Разница</p>
        <h2>Почему комплект принимают</h2>
        <p>
          Оформить бланк умеют все. Разница начинается там, где комплект встречается с приёмкой: кто-то
          сдал и ушёл, а кто-то отвечает за то, что сдал.
        </p>
      </div>

      <div class="utp">
        {
          [
            {
              t: 'Мы были по ту сторону стола',
              d: 'Ведущий инженер работал в техническом заказчике и принимал комплекты сам. Мы знаем, за что цепляется взгляд проверяющего в первые пять минут: несходящиеся даты, ссылки на отменённые редакции, паспорта без привязки к акту.',
            },
            {
              t: 'Замечания закрываем без доплаты',
              d: 'В договоре записано: возврат по нашим документам отрабатываем бесплатно и без ограничения по количеству кругов. Подрядчики на разовых заказах так не работают — им выгоднее сдать и уйти.',
            },
            {
              t: 'Документы идут в темпе стройки',
              d: 'Акты закрываются, пока работа видна. Не «соберём к сдаче», а еженедельная выдача по разделам. Расхождения с проектом всплывают в мае, а не в декабре на комиссии.',
            },
            {
              t: 'Цены открыты',
              d: 'Прайс лежит на сайте целиком, с единицами и вилками. Ни одной строки «по запросу» — считать вы можете до звонка, а не после трёх переговоров.',
            },
          ].map((u) => (
            <article class="utp-i" data-reveal>
              <span class="utp-ic" aria-hidden="true">
                <Icon name="accept" size={20} />
              </span>
              <div>
                <h3>{u.t}</h3>
                <p class="mut">{u.d}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="vs" data-reveal>
        <div class="tw">
          <table>
            <caption class="vh">Сравнение подходов к ведению исполнительной документации</caption>
            <thead>
              <tr>
                <th scope="col">Что важно</th>
                <th scope="col">Разовый подрядчик</th>
                <th scope="col">Штатный инженер</th>
                <th scope="col" class="vs-us">ПрофИД</th>
              </tr>
            </thead>
            <tbody>
              {
                [
                  ['Опыт приёмки со стороны заказчика', 'редко', 'зависит от человека', 'основной опыт'],
                  ['Возвраты после сдачи', 'за отдельные деньги', 'бесплатно', 'бесплатно, без ограничений'],
                  ['Отпуск, больничный, увольнение', 'не касается', 'стройка встаёт', 'подменяет второй инженер'],
                  ['Стоимость на один объект в месяц', 'от 45 000 ₽ разово', 'около 180 000 ₽', 'от 60 000 ₽'],
                  ['Готовность подключиться', '1–2 недели', 'месяц на поиск', 'в тот же день'],
                ].map((row) => (
                  <tr>
                    <th scope="row">{row[0]}</th>
                    <td class="mut">{row[1]}</td>
                    <td class="mut">{row[2]}</td>
                    <td class="vs-us price">{row[3]}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 5. Услуги ════════════════════════════════════════════════════ -->
  <section class="sec" data-theme="dark" id="uslugi">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div>
          <p class="eyebrow">Услуги</p>
          <h2>Что делаем</h2>
        </div>
        <p class="mut">
          Каждую услугу можно заказать отдельно или собрать из них абонентское обслуживание. Цены — из
          общего прайса, скрытых строк нет.
        </p>
      </div>

      <div class="grid grid--3">
        {
          services.map((s, i) => (
            <a
              class={`card card--link srv${i === services.length - 1 ? ' srv--wide' : ''}`}
              href={`/${s.id}`}
              data-reveal
            >
              <p class="eyebrow">{s.data.card.tag}</p>
              <h3>{s.data.h1}</h3>
              <p>{s.data.card.short}</p>
              <p class="srv-p">
                <b class="num acc">
                  {s.data.price.from === 0 ? 'бесплатно' : `от ${s.data.price.from.toLocaleString('ru-RU')} ₽`}
                </b>
                <span class="xs dim">
                  {s.data.price.from === 0 ? 'до 30 позиций' : `за ${s.data.price.unit}`}
                </span>
              </p>
              <span class="tlink">Подробно</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ 6. Калькулятор ═══════════════════════════════════════════════ -->
  <section class="sec" data-theme="light">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div>
          <p class="eyebrow">Калькулятор</p>
          <h2>Посчитайте до звонка</h2>
        </div>
        <p class="mut">
          Двигайте объёмы — вилка и срок пересчитываются сразу. Это оценка по средним ставкам: точную
          цифру инженер называет, посмотрев проект.
        </p>
      </div>

      <div data-reveal>
        <Calculator />
      </div>
    </div>
  </section>

  <!-- ═══ 7. Прайс ═════════════════════════════════════════════════════ -->
  <section class="sec" data-theme="dark" id="ceny">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div>
          <p class="eyebrow">Цены</p>
          <h2>Прайс без «по запросу»</h2>
        </div>
        <p class="mut">
          Основные позиции — ниже. Полный прайс со сметами, ППР и восстановлением лежит на
          <a href="/ceny">отдельной странице</a>.
        </p>
      </div>

      <PriceTable groups={['id', 'abon']} />

      <p class="sec-more">
        <a class="tlink" href="/ceny">Весь прайс, 28 позиций</a>
      </p>
    </div>
  </section>

  <!-- ═══ 8. Свой инженер или внешний отдел ════════════════════════════ -->
  <section class="sec" data-theme="light" id="sravnenie">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Расчёт</p>
        <h2>Свой инженер или внешний отдел</h2>
        <p>
          Считаем честно: у штатного инженера есть плюсы — он на площадке и знает объект изнутри. Вопрос
          только в цене этого удобства и в том, что происходит, когда он уходит в отпуск.
        </p>
      </div>

      <div class="calc2" data-reveal>
        <article class="calc2-c">
          <p class="eyebrow">Штатный инженер ПТО</p>
          <ul class="calc2-rows">
            {
              [
                ['Оклад на руки', '120 000 ₽'],
                ['НДФЛ и страховые взносы', '≈ 52 000 ₽'],
                ['Рабочее место, техника, ПО', '≈ 8 000 ₽'],
                ['Отпуск и больничные в месяц', '≈ 11 000 ₽'],
              ].map((r) => (
                <li>
                  <span>{r[0]}</span>
                  <span class="num">{r[1]}</span>
                </li>
              ))
            }
          </ul>
          <p class="calc2-sum num">≈ 191 000 ₽ <span class="xs dim">в месяц</span></p>
          <p class="xs dim">
            Плюс месяц на поиск замены и простой стройки, если инженер уходит перед сдачей.
          </p>
        </article>

        <div class="calc2-vs" aria-hidden="true"><span>против</span></div>

        <article class="calc2-c calc2-c--us">
          <p class="eyebrow eyebrow--accent">Внешний отдел ПТО</p>
          <ul class="calc2-rows">
            {
              [
