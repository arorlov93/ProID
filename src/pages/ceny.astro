---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PriceTable from '../components/PriceTable.astro';
import Calculator from '../components/Calculator.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbs, faqSchema } from '../lib/schema';
import { byId, fmt, prices } from '../data/prices';

/* Опорные цены первого экрана — из того же прайса, что и таблица ниже. */
const anchors = [byId.aosr, byId.komplekt, byId['abon-s']];

const crumbs = [{ href: '/ceny', t: 'Цены' }];

const faq = [
  {
    q: 'Почему цена указана вилкой, а не точной цифрой',
    a: 'Потому что акт акту рознь. Акт освидетельствования на простую засыпку и акт на узел примыкания с подбором ссылок на четыре раздела проекта — разная работа. Вилка показывает границы честно, а точная цифра называется после того, как инженер посмотрит проект. Обычно в тот же день.',
  },
  {
    q: 'От чего зависит итоговая стоимость',
    a: 'От объёма, от полноты исходных данных и от срочности. Полный комплект материалов с площадки — нижняя граница вилки. Восстановление задним числом добавляет 40%, работа в две смены — ещё 25%. Оба коэффициента заложены в <a href="#kalkulyator">калькулятор</a>.',
  },
  {
    q: 'Есть ли скидки на объём',
    a: 'На комплекте от 300 актов и на абонентском обслуживании от двух объектов ставка ниже прайсовой. Это не акция, а следствие того, что на потоке одного объекта работа идёт быстрее: перечень уже согласован, шаблоны настроены, переписка налажена.',
  },
  {
    q: 'Как происходит оплата',
    a: 'По договору, с юридическим лицом или ИП. Разовые работы — аванс 50% и остаток по факту. Абонентское обслуживание — помесячно, платёж в начале месяца. Работаем с НДС и без, по вашей системе налогообложения.',
  },
  {
    q: 'Что если объём в процессе вырастет',
    a: 'Пересчитываем и согласовываем письменно до того, как делать. Ситуации «сделали и выставили счёт больше» не будет: это разрушает отношения быстрее любой ошибки в акте.',
  },
  {
    q: 'Есть ли бесплатные работы',
    a: 'Да. Экспресс-проверка комплекта до 30 позиций — бесплатно, ответ за один рабочий день. Первая консультация инженера по вашей ситуации — бесплатно. Отработка замечаний по нашим документам — бесплатно и без ограничения по количеству кругов.',
  },
];

const schema = [breadcrumbs(crumbs), faqSchema(faq)];
---

<Base
  title="Исполнительная документация: цена — прайс ПрофИД"
  description="Исполнительная документация: цена от 750 ₽ за акт, комплект по объекту от 45 000 ₽, аутсорсинг ПТО от 60 000 ₽ в месяц. Открытый прайс на 28 позиций."
  path="/ceny"
  schema={schema}
>
  <section class="sec sec--tight" data-theme="dark">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow eyebrow--accent">Прайс</p>
      <h1>Исполнительная документация: цена</h1>
      <p class="lead ce-lead">
        Весь прайс на одной странице: 28 позиций с единицами и вилками. Ни одной строки «по запросу» —
        считать вы можете до звонка, а не после трёх переговоров. Цены действуют для Москвы, области и
        дистанционной работы по России.
      </p>
      {/* Три опорные цены до прокрутки. Страница «Цены», на первом экране
          которой нет ни одной цифры, работает против самой себя. */}
      <ul class="ce-anchor">
        {
          anchors.map((p) => (
            <li>
              <b class="num acc">от {fmt(p.from)} ₽</b>
              <span class="xs dim">за {p.unit}</span>
            </li>
          ))
        }
      </ul>

      <div class="btn-row ce-btns">
        <a class="btn btn--lg" href="#kalkulyator">Посчитать по своим объёмам</a>
        <a class="btn btn--2 btn--lg" href="#zayavka">Обсудить объём</a>
      </div>
    </div>
  </section>

  <section class="sec" data-theme="light">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Направления</p>
        <h2>Прайс по разделам</h2>
        <p>
          Считаем по объёму, а не по площади объекта: два одинаковых по площади объекта дают разное
          количество актов. Единица указана в каждой строке.
        </p>
      </div>

      <PriceTable />
      <div class="note ce-note">
        <p>
          <b>Что влияет на место в вилке.</b> Полные исходные данные с площадки и согласованный на старте
          состав комплекта дают нижнюю границу. Восстановление задним числом добавляет 40% — наценка идёт
          на сбор доказательной базы, а не на оформление. Срочный режим с работой в две смены — ещё 25%.
        </p>
        <p>
          Экспресс-проверка комплекта до 30 позиций и первая консультация инженера — бесплатно. Отработка
          замечаний по нашим документам не тарифицируется вообще, сколько бы кругов ни потребовалось.
        </p>
      </div>
    </div>
  </section>

  <section class="sec" data-theme="dark">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div>
          <p class="eyebrow">Калькулятор</p>
          <h2>Посчитайте по своим объёмам</h2>
        </div>
        <p class="mut">
          Вилка и срок считаются по средним ставкам прайса. Точную цифру инженер называет, посмотрев
          проект.
        </p>
      </div>
      <div data-reveal><Calculator /></div>
    </div>
  </section>

  <section class="sec" data-theme="light">
    <div class="wrap"><Faq items={faq} title="Вопросы про цены" /></div>
  </section>

  <CtaBand
    eyebrow="Заявка"
    title="Назовём цифру по вашему объекту"
    text="Пришлите проект и то, что уже собрано. Инженер посчитает объём и вернётся с вилкой — обычно в тот же день."
    points={['Расчёт бесплатный и ни к чему не обязывает', 'Работаем по договору с юрлицом или ИП', 'Пересчёт объёма согласуем письменно до начала работ']}
    id="zayavka"
    theme="dark"
  />
</Base>

<style>
  .ce-lead { margin-top: var(--s6); }
  .ce-anchor {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4) var(--s8);
    list-style: none;
    margin-top: var(--s7);
  }

  .ce-anchor li {
    display: flex;
    align-items: baseline;
    gap: var(--s2);
    white-space: nowrap;
  }

  .ce-anchor b { font-size: var(--fs-h4); }

  .ce-btns { margin-top: var(--s7); }
  .ce-note { margin-top: var(--s8); }
  @media (max-width: 620px) { .ce-btns .btn { width: 100%; } }
</style>
