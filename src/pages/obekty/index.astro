---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Photo from '../../components/Photo.astro';
import type { PhotoId } from '../../data/photos';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbs, itemListSchema } from '../../lib/schema';

const objects = (await getCollection('objects')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ href: '/obekty', t: 'Объекты' }];
const schema = [
  breadcrumbs(crumbs),
  itemListSchema('Объекты', objects.map((o) => ({ href: `/obekty/${o.id}`, t: o.data.h1 }))),
];
---

<Base
  title="Объекты: где вели исполнительную документацию"
  description="Объекты ПроПТО: общественные здания, объекты культурного наследия, портовая инфраструктура, производство. Что делали на каждом и чем эти объекты отличались."
  path="/obekty"
  schema={schema}
>
  <section class="sec sec--tight" data-theme="dark">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow eyebrow--accent">Объекты</p>
      <h1>Где мы вели документацию</h1>
      <p class="lead ob-lead">
        Общественные здания, объекты культурного наследия, портовая инфраструктура, производство. Разные
        заказчики и разные регламенты приёмки — именно от них зависит, как собирается комплект. В каждой
        карточке разбираем, чем объект был сложен и что из этого следует для похожих задач.
      </p>
    </div>
  </section>

  <section class="sec" data-theme="light">
    <div class="wrap">
      <div class="obl">
        {
          objects.map((o) => (
            <a class="card card--link obc" href={`/obekty/${o.id}`} data-reveal>
              <div class="obc-media">
                <Photo id={`obekt-${o.id}` as PhotoId} caption="" />
              </div>
              <div class="obc-tx">
                <p class="eyebrow">{o.data.city}</p>
                <h2>{o.data.h1}</h2>
                <p class="mut">{o.data.kind}</p>
                <ul class="obc-scope">
                  {o.data.scope.slice(0, 3).map((s) => <li>{s}</li>)}
                </ul>
                <span class="tlink">Что делали</span>
              </div>
            </a>
          ))
        }
      </div>

      <p class="note obl-note">
        Часть объектов под соглашением о неразглашении, поэтому в карточках нет заказчиков и коммерческих
        деталей, а изображения показывают тип объекта, а не сам объект — это рисунки, не съёмка. Если нужны
        рекомендации по конкретному типу объекта — спросите, дадим контакт напрямую.
      </p>
    </div>
  </section>

  <CtaBand
    eyebrow="Ваш объект"
    title="Расскажите про свой"
    text="Тип объекта и регламент приёмки определяют состав комплекта больше, чем площадь. Опишите вводные — скажем, на что смотреть в первую очередь."
    points={['Первая консультация бесплатна', 'Экспресс-проверка комплекта — за один день', 'Работаем по России дистанционно']}
    theme="dark"
  />
</Base>

<style>
  .ob-lead { margin-top: var(--s6); }

  .obl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-card);
  }

  .obc {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  /* Изображение занимает верх карточки целиком. Прежняя подложка с чертежом,
     растворяющимся к краю, давала нечитаемый обрезок штампа и читалась
     грязью, а не иллюстрацией. */
  /* Чертёж рисуется чертёжным синим, рассчитанным на тёмный фон: на светлой
     карточке он выцветал. Подложке задаётся тёмный тон и --dw-ground, иначе
     проёмы в стенах заливались светлым и выглядели дырами. */
  .obc-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--bd-soft);
    background: var(--d);
    --dw-ground: var(--d);
  }

  .obc-media :global(.dw),
  .obc-media :global(.ph) { height: 100%; }

  .obc-media :global(.dw-svg) {
    height: 100%;
    aspect-ratio: auto;
    padding: var(--s4);
    opacity: 0.72;
    transition: opacity var(--t-slow) var(--ease), transform var(--t-slow) var(--ease);
  }

  .obc-media :global(.ph-img) {
    height: 100%;
    aspect-ratio: auto;
    border-radius: 0;
    transition: transform var(--t-slow) var(--ease);
  }

  .obc:hover .obc-media :global(.dw-svg) { opacity: 1; transform: scale(1.02); }
  .obc:hover .obc-media :global(.ph-img) { transform: scale(1.03); }

  .obc-tx {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--s6) var(--s7) var(--s7);
  }

  .obc h2 {
    font-size: var(--fs-h3);
    margin-bottom: var(--s3);
    max-width: 16ch;
  }

  .obc-scope {
    list-style: none;
    display: grid;
    gap: var(--s2);
    margin-block: var(--s5);
    font-size: var(--fs-xs);
    color: var(--tx-dim);
  }

  .obc-scope li {
    padding-left: var(--s5);
    position: relative;
  }

  .obc-scope li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 1px;
    background: var(--accent-line);
  }

  .obl-note { margin-top: var(--s8); }

  @media (max-width: 700px) {
    .obl { grid-template-columns: minmax(0, 1fr); }
  }
</style>
