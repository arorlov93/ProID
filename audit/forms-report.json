    "html": "<form class=\"form-card fade\" id=\"rq\" novalidate=\"\">\n        <div class=\"fgrid\">\n          <div><label for=\"q-name\">Name</label><input id=\"q-name\" type=\"text\" autocomplete=\"name\"></div>\n          <div><label for=\"q-mail\">Work e-mail</label><input id=\"q-mail\" type=\"email\" autocomplete=\"email\"></div>\n          <div><label for=\"q-co\">Company</label><input id=\"q-co\" type=\"text\" autocomplete=\"organization\"></div>\n          <div><label for=\"q-country\">Country</label><input id=\"q-country\" type=\"text\" autocomplete=\"country-name\"></div>\n          <div><label for=\"q-cat\">Category</label>\n            <select id=\"q-cat\">\n              <option>Building and finishing materials</option>\n              <option>Industrial equipment and machinery</option>\n              <option>Tools, hardware and fasteners</option>\n              <option>Metals and pipe</option>\n              <option>Paper, packaging and consumables</option>\n              <option>Food, commodities and beverages</option>\n              <option>Other</option>\n            </select>\n          </div>\n          <div><label for=\"q-terms\">Terms to quote</label>\n            <select id=\"q-terms\"><option>Not sure, advise</option><option>EXW</option><option>FCA</option><option>FOB</option><option>CFR</option><option>CIF</option><option>DAP</option><option>DDP</option></select>\n          </div>\n          <div><label for=\"q-qty\">Quantity</label><input id=\"q-qty\" type=\"text\" placeholder=\"Containers, tonnes, pieces\"></div>\n          <div><label for=\"q-dest\">Destination port or city</label><input id=\"q-dest\" type=\"text\"></div>\n          <div class=\"f-full\"><label for=\"q-spec\">Specification</label><textarea id=\"q-spec\" placeholder=\"Standard, grade, dimensions, certification, deadline\"></textarea></div>\n        </div>\n        <p style=\"margin:20px 0 0\"><button class=\"btn-lg\" type=\"submit\">Start a trade request</button></p>\n        <p class=\"form-note\">This opens your mail client with the request filled in, addressed to info@ispgroupgc.com. Nothing is sent from this page and nothing is stored here.</p>\n      </form>",
