    "hero":    { "ratio": "16:7",  "widths": [1200, 2400] },
    "section": { "ratio": "3:2",   "widths": [900, 1800] },
    "card":    { "ratio": "4:3",   "widths": [600, 1200] }
  },
  "targets": {
    "saturation": 0.22,
    "temperature": 1.02,
    "note": "saturation — средняя насыщенность в HSL, temperature — отношение среднего R к среднему B. К этим числам подтягивается каждый снимок."
  },
